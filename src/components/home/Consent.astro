---
import { X } from '@lucide/astro';
import { getLocale, getUI } from '../../lib/i18n';
import policy from '../../../content/marketing.json';
import { cookiesRoute } from '../../lib/cookies';
import { measurementConfig } from '../../lib/marketing-policy.mjs';
import { serializeJsonLd } from '../../lib/seo-policy.mjs';
interface Props { enabledOnPage?: boolean }
const { enabledOnPage = false } = Astro.props;
const ui = getUI(Astro.url.pathname);
const noticeRoute = cookiesRoute(getLocale(Astro.url.pathname));
const configuration = {
  ...measurementConfig(import.meta.env.PUBLIC_GA4_ID, import.meta.env.PUBLIC_GTM_ID),
  allowlists: policy.attributionAllowlist,
  enabledOnPage,
};
const configured = configuration.provider !== 'none';
---

<script
  type="application/json"
  id="harbor-measurement-config"
  set:html={serializeJsonLd(configuration)}
/>
{configured && enabledOnPage && (
  <aside class="cookie-request" data-consent-request hidden aria-label={ui.consent.title}>
    <p>
      {ui.consent.request}
      <a href={noticeRoute}>{ui.consent.notice}</a>
    </p>
    <div class="cookie-actions">
      <button type="button" data-consent-reject>{ui.consent.reject}</button>
      <button type="button" data-consent-accept>{ui.consent.accept}</button>
    </div>
  </aside>
)}
<dialog id="cookie-settings" class="cookie-dialog" data-consent-dialog aria-labelledby="cookie-settings-title">
  <div class="cookie-dialog-heading">
    <h2 id="cookie-settings-title">{ui.consent.title}</h2>
    <button type="button" class="cookie-close" data-consent-close aria-label={ui.consent.close}>
      <X size={22} aria-hidden="true" />
    </button>
  </div>
  <dl class="cookie-categories">
    <div>
      <dt>{ui.consent.necessary}</dt>
      <dd>{ui.consent.necessaryDescription}</dd>
    </div>
    <div>
      <dt>{ui.consent.optional}</dt>
      <dd>{configured ? ui.consent.description : ui.consent.unconfigured}</dd>
    </div>
  </dl>
  {configured && (
    <div class="cookie-status" aria-live="polite">
      <p data-privacy-signal hidden>{ui.consent.privacySignal}</p>
      <p data-consent-status="accepted" hidden>{ui.consent.statusAccepted}</p>
      <p data-consent-status="rejected" hidden>{ui.consent.statusRejected}</p>
      <p data-consent-status="unset" hidden>{ui.consent.statusUnset}</p>
    </div>
  )}
  <a href={noticeRoute}>{ui.consent.notice}</a>
  {configured && (
    <div class="cookie-actions">
      <button type="button" data-consent-reject>{ui.consent.reject}</button>
      <button type="button" data-consent-accept>{ui.consent.accept}</button>
    </div>
  )}
</dialog>

<script>
  import { initMarketing } from '../../scripts/marketing';
  initMarketing();
</script>

<style>
  .cookie-request,
  .cookie-dialog {
    color: var(--ink);
    background: var(--paper, var(--hw-paper));
    border: 1px solid var(--line, var(--hw-line));
    border-radius: 16px;
    font: 400 .875rem/1.55 var(--sans, var(--hw-sans));
  }
  .cookie-request {
    position: fixed;
    z-index: 40;
    inset: auto 1rem max(1rem, env(safe-area-inset-bottom));
    max-width: 60rem;
    max-height: 70dvh;
    margin-inline: auto;
    padding: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    overflow: auto;
    box-shadow: 0 8px 40px #061a3326;
  }
  .cookie-request p,
  .cookie-status p {
    margin: 0;
  }
  .cookie-request a {
    display: block;
    width: fit-content;
    margin-top: .2rem;
  }
  .cookie-dialog {
    width: min(36rem, calc(100% - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: clamp(1rem, 4vw, 2rem);
    overflow: auto;
  }
  .cookie-dialog::backdrop {
    background: #061a3399;
  }
  .cookie-dialog-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: .75rem;
  }
  .cookie-dialog h2 {
    margin: 0;
    font: 400 clamp(1.5rem, 4vw, 2rem)/1.15 var(--serif, var(--hw-serif));
  }
  .cookie-close {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border: 0;
    border-radius: .5rem;
    color: inherit;
    background: transparent;
    cursor: pointer;
  }
  .cookie-categories {
    display: grid;
    gap: .875rem;
    margin: .875rem 0;
  }
  .cookie-categories dt {
    font-weight: 600;
  }
  .cookie-categories dd {
    margin: .15rem 0 0;
  }
  .cookie-status {
    margin-bottom: .5rem;
  }
  .cookie-request a,
  .cookie-dialog a {
    color: var(--blue-dark, var(--hw-blue));
    text-decoration: underline;
    text-underline-offset: .2em;
  }
  .cookie-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .5rem;
  }
  .cookie-dialog .cookie-actions {
    margin-top: 1rem;
  }
  .cookie-actions button {
    min-height: 44px;
    padding: .55rem .875rem;
    color: inherit;
    background: transparent;
    border: 1px solid currentColor;
    border-radius: .5rem;
    font: 500 .875rem/1.3 var(--sans, var(--hw-sans));
    cursor: pointer;
  }
  .cookie-actions button:hover:not(:disabled),
  .cookie-close:hover {
    background: color-mix(in srgb, currentColor 7%, transparent);
  }
  .cookie-actions button:disabled {
    cursor: not-allowed;
    opacity: .55;
  }
  @media (max-width: 700px) {
    .cookie-request {
      flex-direction: column;
      align-items: stretch;
    }
  }
  @media (max-width: 560px) {
    .cookie-dialog {
      inset: auto 0 0;
      width: 100%;
      max-width: none;
      max-height: min(85dvh, calc(100dvh - 1rem));
      margin: 0;
      padding-bottom: max(1rem, env(safe-area-inset-bottom));
      border-radius: 16px 16px 0 0;
    }
  }
</style>
