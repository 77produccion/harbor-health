---
import { Play, Pause } from '@lucide/astro';
import { getUI } from '../lib/i18n';
interface Props {
  id: string;
  src: string;
  poster: string;
  class?: string;
  sizes?: string;
  hero?: boolean;
}
const { id, src, poster, class: className = '', sizes = '100vw', hero = false } = Astro.props;
const ui = getUI(Astro.url.pathname);
---

<div class:list={['editorial-video', className]} data-editorial-video={id}>
  <picture aria-hidden="true">
    <img
      src={`/images/${poster}-poster-1600.webp`}
      srcset={`/images/${poster}-poster-800.webp 800w, /images/${poster}-poster-1600.webp 1600w`}
      sizes={sizes}
      width="1600"
      height="900"
      alt=""
      loading={hero ? 'eager' : 'lazy'}
      fetchpriority={hero ? 'high' : 'auto'}
      decoding="async"
      data-hero-image={hero ? '' : undefined}
    />
  </picture>
  <video
    id={`${id}-video`}
    data-video-src={src}
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    tabindex="-1"
  ></video>
  <button
    type="button"
    class="editorial-video-control"
    aria-label={ui.media.play}
    aria-controls={`${id}-video`}
    data-video-control
    data-play-label={ui.media.play}
    data-pause-label={ui.media.pause}
    hidden
  >
    <span data-video-play-icon aria-hidden="true">
      <Play size={17} stroke-width={1.5} />
    </span>
    <span data-video-pause-icon aria-hidden="true" hidden>
      <Pause size={17} stroke-width={1.5} />
    </span>
  </button>
</div>

<script>
  import { initEditorialVideos } from '../scripts/editorial-video';
  initEditorialVideos();
</script>

<style>
  .editorial-video {
    display: block;
    position: relative;
    overflow: clip;
    min-width: 0;
    background: #061a33;
  }
  .editorial-video.hw-hero-media {
    position: absolute;
    inset: 0;
  }
  .editorial-video picture,
  .editorial-video video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .editorial-video img,
  .editorial-video video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }
  .editorial-video video {
    opacity: 0;
    transition: opacity 0.45s;
  }
  .editorial-video.has-video-frame video {
    opacity: 1;
  }
  .editorial-video.hw-hero-media :is(img, video) {
    object-position: center;
  }
  @media (max-width: 999px) {
    .editorial-video.hw-hero-media {
      position: relative;
      inset: auto;
      order: 1;
      width: 100%;
      aspect-ratio: 16 / 9;
      flex-shrink: 0;
    }
  }
  .editorial-video-control {
    position: absolute;
    z-index: 4;
    bottom: 24px;
    left: 24px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid #ffffff70;
    border-radius: 4px;
    background: #061a33e6;
    color: #fff;
    cursor: pointer;
  }
  .editorial-video-control:hover {
    background: #061a33;
  }
  .editorial-video-control:focus-visible {
    outline: 3px solid #01919f;
    outline-offset: 4px;
  }
</style>
