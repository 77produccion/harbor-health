{
  "name": "harbor-health-commercial",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "prebuild": "node scripts/build-assets.mjs",
    "assets:build": "node scripts/build-assets.mjs",
    "build:publish": "node scripts/publish-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "format": "prettier --write src",
    "test:browser": "playwright test",
    "content:check": "node scripts/check-content.mjs",
    "content:matrix": "node scripts/check-content.mjs --matrix",
    "content:matrix:write": "node scripts/check-content.mjs --write-matrix",
    "content:publish-check": "node scripts/check-content.mjs --publish",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@mdx-js/mdx": "^3.1.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.3",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@lucide/astro": "^1.70.0",
    "astro": "^7.4.7",
    "gsap": "^3.15.1",
    "pdf-lib": "^1.17.1"
  }
}
