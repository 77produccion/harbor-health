# Solo el proyecto comercial independiente. El resto del workspace es local.
/*
!/.gitignore
!/.gitattributes
!/.env.example
!/.prettierrc.json
!/AGENTS.md
!/README.md
!/THIRD_PARTY_NOTICES.md
!/astro.config.mjs
!/package.json
!/package-lock.json
!/playwright.config.ts
!/tsconfig.json
!/src/
!/content/
!/tests/
!/scripts/
!/docs/
!/public/

# Código de prototipos sin consumidores en las rutas actuales.
/src/components/Hero.astro
/src/components/HomeStory.astro
/src/components/ProductDemo.astro

# Solo comandos usados por package.json y sus dependencias.
/scripts/*
!/scripts/build-assets.mjs
!/scripts/build-editorial-images.mjs
!/scripts/build-home-images.mjs
!/scripts/check-content.mjs
!/scripts/content-model.mjs
!/scripts/publish-build.mjs
!/scripts/scene-content.mjs

# Documentación de mantenimiento vigente; las auditorías quedan locales.
/docs/*
!/docs/project-guide.md
!/docs/assets.md
!/docs/repository.md

